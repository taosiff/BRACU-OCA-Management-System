# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection (REQUIRED in production)
# Example Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=BRACU_OCA

# JWT Secret (REQUIRED in production - use a long random string, e.g. 64+ chars)
JWT_SECRET=replace_with_a_strong_random_secret

# Allowed Frontend Origins (comma-separated in production, e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173
